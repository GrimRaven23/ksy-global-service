# PostgreSQL — Supabase
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[MOT-DE-PASSE]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session secret (generate a strong random string, e.g.: openssl rand -hex 32)
SESSION_SECRET="change-me-to-a-strong-random-string"

# Node environment
NODE_ENV="development"
