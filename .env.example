# ══════════════════════════════════════════════════════════════
# KSY Global Service — Environment Variables
# ══════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in the values.

# PostgreSQL connection URL (Supabase pooler, port 6543, transaction mode)
# Required: for runtime database queries via Prisma
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=30"

# PostgreSQL direct connection URL (port 5432, session mode)
# Optional: used by Prisma Migrate for schema migrations
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Session signing secret (min 32 characters, hex string recommended)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-strong-random-string-at-least-32-chars"

# Node environment: development | production | test
NODE_ENV="development"
