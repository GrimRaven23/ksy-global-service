# Database (Supabase PostgreSQL)
# Use the transaction pooler URL (port 6543) for runtime
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=30&sslmode=require"
# Use the direct connection URL (port 5432) for migrations — falls back to pooler if unreachable
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Session (generate a 64-char random hex string)
SESSION_SECRET="generate-a-random-string-at-least-32-characters-long"

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3099"
