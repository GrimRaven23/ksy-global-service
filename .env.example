# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Session
SESSION_SECRET="generate-a-random-string-at-least-32-characters-long"

# Optional: Legacy auth compat
NEXTAUTH_SECRET="generate-a-random-string-at-least-32-characters-long"
